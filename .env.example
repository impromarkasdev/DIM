# Azure Entra client credentials with Microsoft Graph application permission Files.ReadWrite.All.
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-app-client-id
AZURE_CLIENT_SECRET=your-app-client-secret
AZURE_AUTH_MODE=client_credentials
# Use exactly one target. GRAPH_DRIVE_ID is preferred for a SharePoint library.
GRAPH_DRIVE_ID=your-onedrive-or-sharepoint-drive-id
# GRAPH_USER_ID=user@impromarkas.com

# The authenticated user's personal OneDrive. Do not set GRAPH_DRIVE_ID for it.
EXCEL_PATH=/Impromarkas/Facturas - Compras - Argelia/Base_Datos_DIM_importadas_Impromarkas.xlsx
# Ruta de carpetas anuales que se rastrean después de encontrar AP/AQ/AR.
DIM_BASE_PATH=/Impromarkas/Facturas - Compras - Argelia
EXCEL_LOOKUP_COLUMN_INDEX=0
EXCEL_PDF_COLUMN_INDEX=2
EXCEL_LOCATION_COLUMN_INDEX=3
EXCEL_FIRST_YEAR=2021
MAX_RESPONSE_PDF_BYTES=3000000

# API security and user management.
WEBHOOK_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-different-long-random-secret
JWT_SECRET=replace-with-a-third-long-random-secret
POSTGRES_URL=your-vercel-postgres-connection-string
ADMIN_EMAIL=admin@impromarkas.com
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-12-character-minimum-password
CORS_ORIGINS=https://impromarkas.com,https://www.impromarkas.com

STANDARD_SENSITIVE_TERMS=cedula,nit,tarjeta de credito
